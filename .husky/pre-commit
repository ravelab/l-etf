#!/usr/bin/env bash
# Quiet pre-commit: only emit output on failure to save tokens.

set -e

run_quiet() {
  local label="$1"
  shift
  local output
  if ! output=$("$@" 2>&1); then
    echo "=== $label FAILED ==="
    echo "$output"
    exit 1
  fi
}

# Lint only staged files (eslint reports nothing on clean pass).
run_quiet "lint-staged" npx lint-staged

# tsc --noEmit is silent on success; capture in case it ever isn't.
run_quiet "typecheck" npm run typecheck --silent

# node --test prints per-test lines even on success; only surface on failure.
run_quiet "test" npm test --silent
