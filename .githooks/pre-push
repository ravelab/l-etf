#!/bin/sh
# Local push hook — intentionally empty of test suites.
#
# Unit tests (and their coverage floor) run in GitHub Actions on the push
# (.github/workflows/test.yml). Post-deploy UI coverage/artifacts come from
# ui-after-deploy.yml. Keeping the suite here duplicated CI and delayed the
# push that produces those artifacts.
#
# Skipped messaging for main remains: main only ever advances by a fast-forward
# of an already-green dev (scripts/merge-dev-to-main.sh).
set -eu

# git feeds one line per ref being pushed: <local ref> <local sha> <remote ref> <remote sha>.
pushing_anything=no
pushing_non_main=no
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  [ -z "${remote_ref:-}" ] && continue
  pushing_anything=yes
  case "$remote_ref" in
    refs/heads/main) ;;
    *) pushing_non_main=yes ;;
  esac
done

if [ "$pushing_anything" = no ]; then
  exit 0
fi
if [ "$pushing_non_main" = no ]; then
  echo '→ pre-push: main is a fast-forward of an already-tested dev; skipping.'
  exit 0
fi

echo '→ pre-push: suites run in GitHub Actions after push (test.yml + ui-after-deploy).'
exit 0
