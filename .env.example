# All variables in this file are OPTIONAL. The app runs without them; it just
# uses whatever CSV data is already in ./data (the repo ships with bundled
# CSVs covering recent history). Add keys below to enable optional features.

# ─────────────────────────────────────────────────────────────────────────────
# Latest market data (auto-refresh of bundled CSVs).
# When BOTH keys are set, the app will refresh ./data/*.csv automatically:
# the first incoming request that arrives after 7pm New York time triggers a
# background fetch (market close + 3h). At most one attempt per NY date;
# silent on failure (the app keeps serving the cached data).
# Without these keys, the bundled CSVs are used as-is — backtests still work,
# you just won't get new market days until you `npm run fetch-data` manually.
# ─────────────────────────────────────────────────────────────────────────────

# Tiingo API key — modern ETF and index daily prices.
# Free tier is sufficient for personal use. Sign up: https://www.tiingo.com/
TIINGO_API_KEY=

# FRED API key — historical index closes (SPX, NDX), CPI inflation, rates.
# Free. Request a key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Set to "false" to disable the auto-refresh background task even when the
# Tiingo + FRED keys are configured (e.g. if you'd rather run `npm run
# fetch-data` from your own cron). Default: enabled.
AUTO_REFRESH_DATA=


# ─────────────────────────────────────────────────────────────────────────────
# Reserved for future use; Stooq is currently fetched without authentication.
# ─────────────────────────────────────────────────────────────────────────────

STOOQ_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# Push notifications for SMA-signal alerts.
# Requires BOTH the VAPID keys AND the Upstash Redis block below. Skip both
# blocks to disable push entirely; the app will run normally without alerts.
# ─────────────────────────────────────────────────────────────────────────────

# Generate a keypair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Required when push is enabled. Format: mailto:you@example.com (or an https
# URL). Browsers reject pushes without a valid subject.
VAPID_SUBJECT=

# Upstash Redis stores push subscriptions and the last-notified SMA state.
# Free tier works. Sign up: https://upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ─────────────────────────────────────────────────────────────────────────────
# Scheduled data refresh via Vercel cron.
# These power the cron in vercel.json. Self-hosters can leave them empty —
# the auto-refresh feature above replaces this on non-Vercel deployments.
# ─────────────────────────────────────────────────────────────────────────────

# Bearer token protecting /api/cron/refresh-data. Generate any random string
# (e.g. `openssl rand -hex 32`). Callers must send Authorization: Bearer <value>.
CRON_SECRET=

# Vercel Deploy Hook URL — only meaningful on Vercel deployments.
# Lets the cron endpoint trigger a redeploy when new index closes appear.
# Create one under Vercel project → Settings → Git → Deploy Hooks.
VERCEL_DEPLOYMENT_HOOK_URL=


# ─────────────────────────────────────────────────────────────────────────────
# Weekly artifact auto-commit (for forks that want CI to push CSVs).
# GitHub personal access token used by scripts/commit-data-csvs.mjs to push
# refreshed CSVs and engine.ts back to the repo. Leave empty to disable.
# ─────────────────────────────────────────────────────────────────────────────

GITHUB_TOKEN=


# ─────────────────────────────────────────────────────────────────────────────
# UI feature flags.
# ─────────────────────────────────────────────────────────────────────────────

# Show the /box-trades page (SPX box-spread implied-rate report).
# Hidden by default. Set to "true" to expose the page and its nav link.
# The NEXT_PUBLIC_ prefix is required so the flag reaches client components
# (Header nav, Home card).
NEXT_PUBLIC_DISPLAY_BOX_TRADES=

# Public site URL used by app/sitemap.ts. Defaults to http://localhost:3000.
# Set this in production to your deployed origin (e.g. https://example.com).
NEXT_PUBLIC_SITE_URL=
