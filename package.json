{
  "name": "l-etf",
  "version": "1.0.0",
  "private": true,
  "description": "Next.js app for backtesting leveraged-ETF strategies over long market history with rolling-window analysis, SMA timing rules, risk-off switching, and trade-level detail.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:vercel": "node --import tsx scripts/build-vercel.ts",
    "start": "next start",
    "lint": "./scripts/quiet-run.sh 'lint' eslint --max-warnings 0 .",
    "knip": "./scripts/quiet-run.sh 'knip' knip",
    "typecheck": "./scripts/quiet-run.sh 'typecheck' tsc --noEmit",
    "fetch-data": "node --import tsx scripts/fetch-data.ts",
    "calibrate": "node --import tsx scripts/calibrate-etfs.ts",
    "calibrate-sma": "node --import tsx scripts/bounded-sma-command.ts calibration",
    "refresh-sma": "node --import tsx scripts/refresh-sma.ts",
    "explore-sma": "node --import tsx scripts/bounded-sma-command.ts seeds",
    "explore-sma-cagr": "node --import tsx scripts/bounded-sma-command.ts presets --write-presets",
    "commit-data": "node scripts/commit-data.mjs",
    "notify:sma-alerts": "node --import tsx scripts/notify-sma-alerts.ts",
    "snapshots:generate": "node --import tsx scripts/generate-snapshots.ts",
    "snapshots:test": "node --input-type=module -e \"import('./scripts/test-snapshots.mjs')\"",
    "test": "npm run --silent test:unit",
    "test:unit": "./scripts/unit-test.sh",
    "test:coverage": "node scripts/coverage-combined.mjs",
    "precommit": "npm run --silent lint && npm run --silent typecheck && npm run --silent knip",
    "check": "npm run precommit && npm run build",
    "setup:hooks": "git config core.hooksPath .githooks",
    "push:dev": "./scripts/push-dev.sh",
    "ship": "./scripts/ship-dev.sh",
    "promote": "./scripts/merge-dev-to-main.sh",
    "promote:now": "./scripts/merge-dev-to-main.sh --no-verify",
    "test:e2e": "node e2e-tests/run.mjs",
    "e2e-tests": "npm run --silent test:e2e"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@upstash/redis": "^1.40.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.10.5",
    "@vercel/speed-insights": "^2.0.0",
    "chart.js": "^4.6.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "mcp-handler": "^2.3.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.3.1",
    "sonner": "^2.0.8",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "knip": {
    "entry": [
      "scripts/*.{ts,mjs,js}",
      "scripts/lib/*.{ts,mjs,js}",
      "unit-tests/**/*.test.ts",
      "unit-tests/**/*.test.tsx"
    ],
    "ignore": [
      "public/sw.js",
      "e2e-tests/**"
    ]
  },
  "devDependencies": {
    "@jridgewell/sourcemap-codec": "^1.6.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^5.0.5",
    "ast-v8-to-istanbul": "^1.0.7",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "jsdom": "^29.1.1",
    "knip": "^6.44.0",
    "postcss": "^8.5.32",
    "puppeteer": "^25.16.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "postcss": "^8.5.32",
    "@vercel/cli-config": {
      "zod": "$zod"
    },
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^6.1.5"
    }
  }
}
